{
  "name": "agent-copilot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "npm run typecheck && nuxt build",
    "preview": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx test/smoke-http.ts",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "spike": "tsx scripts/spike/run-all.ts",
    "spike:auth": "tsx scripts/spike/00-auth.ts",
    "spike:sender": "tsx scripts/spike/01-sender-type.ts",
    "spike:media": "tsx scripts/spike/02-multimodal.ts",
    "spike:poll": "tsx scripts/spike/03-incremental.ts",
    "spike:knowledge": "tsx scripts/spike/04-knowledge.ts",
    "spike:ai": "tsx scripts/spike/05-ai-structured.ts",
    "spike:boundary": "tsx scripts/spike/07-auth-boundary.ts",
    "spike:format": "tsx scripts/spike/08-format-scan.ts",
    "spike:followup": "tsx scripts/spike/09-followups.ts",
    "spike:agents": "tsx scripts/spike/10-agent-retest.ts",
    "spike:contract": "tsx scripts/spike/11-working-agents.ts",
    "build:only": "nuxt build",
    "spike:presence": "tsx scripts/spike/12-presence-watch.ts"
  },
  "dependencies": {
    "@imbrace/sdk": "^1.4.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@vueuse/nuxt": "^14.4.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.126",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.7",
    "vue-tsc": "^3.3.11"
  }
}
