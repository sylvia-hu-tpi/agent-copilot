# 複製為 .env.local 後填入。.env.local 已在 .gitignore 中。
#
# ⚠️ 填寫時請「取代」既有的空白行，不要新增重複的鍵 ——
#    Node 的 loadEnvFile 取最後一筆，重複鍵會讓後面的空值覆蓋前面的實際值。

# ── 環境 ──────────────────────────────────────────
# develop | sandbox | stable | prodv2
#
# ⚠️ stable 與 prodv2 是同一個 gateway（app-gatewayv2.imbrace.co），
#    也就是「正式環境」。若 iMBrace 給你的 API Host 是 app-gatewayv2.imbrace.co，
#    那就填 stable，並且務必注意：你操作的是真實客戶資料。
IMBRACE_ENV=stable

# 若 iMBrace 直接給你一個 URL 而非環境名稱，可用此項覆寫上面的預設對應。
IMBRACE_BASE_URL=

# ── 認證方式擇一 ──────────────────────────────────
# (A) API Key（server-to-server，組織層級的廣泛權限，非個別客服身分）
#     iMBrace 後台產生的通常是這種，格式為 api_xxxxx。
#     ⚠️ 必須同時填 IMBRACE_ORGANIZATION_ID —— gateway 不會從 key 自動推導組織。
IMBRACE_API_KEY=
IMBRACE_ORGANIZATION_ID=

# (B) 個別客服的 access token（格式 acc_xxxxx）
#     正式產品走這條：JOIN 與訊息送出才能正確歸屬到人、保留稽核軌跡。
IMBRACE_ACCESS_TOKEN=

# (C) 走 OTP 流程現場取得 token（npm run spike:auth 會引導）
#     驗證 H-5（角色資訊）只能走這條 —— API Key 不帶使用者角色。
IMBRACE_EMAIL=

# ── 探測目標 ──────────────────────────────────────
# ⚠️ conversations.list() 沒有 business unit scope 會永遠回傳空陣列，
#    必須用 conversations.search({ businessUnitId, q }) 才取得到。
#    BU id 可由 channel.list() 的 bu_id 取得。
SPIKE_BUSINESS_UNIT_ID=

# ⚠️ 上面那個 bu_ 值只適用 SDK 的 conversations.*。
#    cloud.imbrace.co/api/channel-service/** 的 business_unit_id 參數吃的是
#    另一種 pub_ 開頭的識別碼。傳錯不會報錯，只會靜默回 0 筆。
#    可由 GET cloud.imbrace.co/api/platform/v1/business_units 的 data[].public_id
#    程式化取得（17-message-templates.ts 已內建這個來源，通常不需手動填此變數）；
#    留空時腳本仍會自動探測，這裡只是備援／可覆寫的手動值。見 docs/PLATFORM_CAPABILITY.md §4.1。
SPIKE_PUBLIC_ID=

# 主要探測對話：需含多種發送者（con_ 客戶 / u_ 真人客服 / pub_ 疑似 AI）
SPIKE_CONVERSATION_ID=

# 含附件的對話。⚠️ H-2 需要「同時含圖片與語音」的對話才驗得出來，
#    目前正式環境的資料只有 text 與 file，尚無 image / audio。
SPIKE_ATTACHMENT_CONVERSATION_ID=

# 知識庫探測用的 board id（若已有 SOP board）
SPIKE_BOARD_ID=

# 05-ai-structured.ts 要測的模型名稱（留空則自動取第一個可用的）
SPIKE_AI_MODEL=

# ── AgentCopilot 自身 ──────────────────────────────────
# ⚠️ nuxt.config.ts 會把這一區的鍵橋接成 Nuxt 的 NUXT_* 慣例，
#    所以本檔維持一套命名即可（spike 腳本與 Nuxt 共用）。
#    正式環境不放 .env，直接注入 NUXT_SESSION_SECRET 等變數。

# session cookie 的簽章金鑰。⚠️ 必填 —— 缺少時所有登入請求會回 500。
# 產生一把：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# ⚠️ 多副本部署時每個副本必須用同一把，否則症狀是「隨機被登出」。
SESSION_SECRET=

# webhook HMAC 驗簽用（M4，規格待 iMBrace 提供）
WEBHOOK_SECRET=

# 自建 AI 層的金鑰（M2，備援 VikiAIProvider 用，目前尚未實作，見 docs/ARCHITECTURE.md §8.2b）
AI_API_KEY=

# ImbraceAgentProvider（specs/001-sentiment-panel）——摘要／情緒兩個 AI Agent 的 assistant_id，
# 由使用者在 iMBrace 後台手動建立（Behavior Settings 分頁設定 prompt，見該 spec 的討論記錄）。
# ⚠️ 缺任一項時 useAIProvider() 會退回 MockAIProvider 並印警告（server/services/ai/index.ts）——
#    僅供本機開發，正式環境不應缺這兩個值。
# 建立後可用 `npm run spike:copilot-agents` 或 `npm run spike:verify-provider` 驗證是否可用。
IMBRACE_SUMMARY_AGENT_ID=
IMBRACE_SENTIMENT_AGENT_ID=

# AgentKnowledgeProvider／ImbraceAgentProvider.suggest()（specs/002-suggestion-knowledge-search）——
# 知識庫快查／建議回覆兩個 AI Agent 的 assistant_id，同樣由使用者在 iMBrace 後台手動建立
# （知識庫檢索 agent 需掛載 Knowledge Hub，建議回覆 agent 不掛，見 research.md #4）。
# ⚠️ 缺任一項時 useKnowledgeProvider()／useAIProvider() 會分別退回 MockKnowledgeProvider／
#    Mock 的 suggest() 實作並印警告——僅供本機開發，正式環境不應缺這兩個值。
IMBRACE_KNOWLEDGE_AGENT_ID=
IMBRACE_SUGGESTION_AGENT_ID=

# 多副本時必需（M4）。單副本留空即用記憶體實作。
REDIS_URL=
