# 複製為 .env.local 後填入。.env.local 已在 .gitignore 中。
#
# 本檔分三段：① 執行 AgentCopilot 必填　② 只有跑對應 spike 腳本才需要　③ M4 尚未接線。
# .env.local 只需要放你實際有值的鍵；② 的鍵留空或不寫都合法（harness 對未定義鍵回空字串）。
#
# ⚠️ 填寫時請「取代」既有的空白行，不要新增重複的鍵 ——
#    Node 的 loadEnvFile 取最後一筆，重複鍵會讓後面的空值覆蓋前面的實際值。

# ══════════════════════════════════════════════════════════════════════
# ① 執行 AgentCopilot 必填
#    Nuxt 執行期會讀。nuxt.config.ts 在 dev／build 時把這一區橋接成 NUXT_* 慣例，
#    所以本檔維持一套命名即可（spike 腳本與 Nuxt 共用）。
#    正式環境（容器）不放 .env，直接注入 NUXT_*：鍵清單在 deploy/agent-copilot.env.example。
# ══════════════════════════════════════════════════════════════════════

# ── 環境 ──────────────────────────────────────────
# develop | sandbox | stable | prodv2
#
# ⚠️ stable 與 prodv2 是同一個 gateway（app-gatewayv2.imbrace.co），
#    也就是「正式環境」。若 iMBrace 給你的 API Host 是 app-gatewayv2.imbrace.co，
#    那就填 stable，並且務必注意：你操作的是真實客戶資料。
IMBRACE_ENV=stable

# 若 iMBrace 直接給你一個 URL 而非環境名稱，可用此項覆寫上面的預設對應；否則留空。
IMBRACE_BASE_URL=

# ── iMBrace 憑證（API Key：server-to-server，組織層級的廣泛權限） ──
#    iMBrace 後台產生的通常是這種，格式為 api_xxxxx。
#    ⚠️ 必須同時填 IMBRACE_ORGANIZATION_ID —— gateway 不會從 key 自動推導組織。
IMBRACE_API_KEY=
IMBRACE_ORGANIZATION_ID=

# ── session ───────────────────────────────────────
# session cookie 的簽章金鑰。⚠️ 必填 —— 缺少時所有登入請求會回 500。
# 產生一把：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# ⚠️ 多副本部署時每個副本必須用同一把，否則症狀是「隨機被登出」。
SESSION_SECRET=

# ── 五個 iMBrace agent 的 assistant_id（使用者在 iMBrace 後台手動建立，因環境而異） ──
# ImbraceAgentProvider（specs/001-sentiment-panel）——摘要／情緒兩個 AI Agent。
# ⚠️ 缺任一項時 useAIProvider() 會退回 MockAIProvider 並印警告（server/services/ai/index.ts）——
#    僅供本機開發，正式環境不應缺這兩個值。
# 建立後可用 `npm run spike:copilot-agents` 或 `npm run spike:verify-provider` 驗證是否可用。
IMBRACE_SUMMARY_AGENT_ID=
IMBRACE_SENTIMENT_AGENT_ID=

# AgentKnowledgeProvider／ImbraceAgentProvider.suggest()（specs/002-suggestion-knowledge-search）——
# 知識庫快查／建議回覆兩個 AI Agent（知識庫檢索 agent 需掛載 Knowledge Hub，建議回覆 agent 不掛，見 research.md #4）。
# ⚠️ 缺任一項時 useKnowledgeProvider()／useAIProvider() 會分別退回 MockKnowledgeProvider／
#    Mock 的 suggest() 實作並印警告——僅供本機開發，正式環境不應缺這兩個值。
IMBRACE_KNOWLEDGE_AGENT_ID=
IMBRACE_SUGGESTION_AGENT_ID=

# ImbraceAgentProvider.summarizeClosure()（specs/006-closure-handoff-summary）——
# 結案摘要 AI Agent（`AgentCopilot_結案摘要_agent`）。
# ⚠️ **既有四個 agent 沒有一個產得出 ClosureSummary**：摘要 agent 的 core_task 逐字寫死了
#    ConversationSummary 的九個欄位，與結案摘要的欄位沒有交集（該 spec research.md #1）。
#    因此這是第五個 agent，不是重用。
# ⚠️ 缺少時**不會**退回 Mock —— server/services/ai/index.ts 刻意把它排除在
#    「缺一即退回 MockAIProvider」的判定之外（其餘四個 agent 齊全就用真 provider）。
#    壞的範圍要與缺的東西一致，而靜默退回 Mock 會把一份固定的假摘要寫進正式 CRM。
#    實際症狀：按下結案後在**產生草稿**那一步當場 502，面板顯示「結案摘要產生失敗」＋重試。
IMBRACE_CLOSURE_AGENT_ID=

# ── Data Board：結案摘要的正式紀錄（specs/006-closure-handoff-summary）──────
# `AgentCopilot_ClosureSummary` board 的 id，由 `npm run board:setup` 建立後印出。
# ⚠️ **執行期一律以此 id 為準，MUST NOT 依名稱查找**——名稱不是唯一鍵，
#    同名 board 會讓寫入靜默落到錯的地方，而 Board 是正式 CRM，寫錯不會有錯誤訊息。
# 換環境時重跑 `npm run board:setup`；驗證欄位是否齊全用 `npm run board:verify`。
# SIT demo MUST 用 demo 專用 Board（ARCHITECTURE §16.5）：把這個鍵暫時清空再跑一次 board:setup。
IMBRACE_CLOSURE_BOARD_ID=

# ══════════════════════════════════════════════════════════════════════
# ② 只有跑對應 spike 腳本才需要（scripts/spike/**，npm run spike:*）
#    AgentCopilot 本身不讀這一段。留空或不寫都合法。
# ══════════════════════════════════════════════════════════════════════

# `npm run spike:auth`：走 OTP 流程現場取得 token 用的 email。
# 驗證 H-5（角色資訊）只能走這條 —— API Key 不帶使用者角色。
IMBRACE_EMAIL=

# 個別客服的 access token（格式 acc_xxxxx），由 spike:auth 寫入；spike:boundary 拿它與 API Key 比對權限邊界。
# ⚠️ **一旦有值，harness 的 makeClient() 會優先用它**，所有 spike 的認證身分都會悄悄從
#    「組織 API Key」換成「這個客服」。不是在做認證邊界實測時，保持空白或整行拿掉。
IMBRACE_ACCESS_TOKEN=

# ⚠️ conversations.list() 沒有 business unit scope 會永遠回傳空陣列，
#    必須用 conversations.search({ businessUnitId, q }) 才取得到。
#    留空時 harness 會以 channel.list() 的 bu_id 自動探測；這裡只是備援／可覆寫的手動值。
SPIKE_BUSINESS_UNIT_ID=

# ⚠️ 上面那個 bu_ 值只適用 SDK 的 conversations.*。
#    cloud.imbrace.co/api/channel-service/** 的 business_unit_id 參數吃的是
#    另一種 pub_ 開頭的識別碼。傳錯不會報錯，只會靜默回 0 筆。
#    可由 GET cloud.imbrace.co/api/platform/v1/business_units 的 data[].public_id
#    程式化取得（17-message-templates.ts 已內建這個來源，通常不需手動填此變數）。
#    見 docs/PLATFORM_CAPABILITY.md §4.1。
SPIKE_PUBLIC_ID=

# 主要探測對話：需含多種發送者（con_ 客戶 / u_ 真人客服 / pub_ 疑似 AI）
SPIKE_CONVERSATION_ID=

# 建議卡兩段式的端到端量測（`npm run spike:progressive`，004 T032）——逗號分隔。
# ⚠️ SC-002 量的是「有知識庫命中的對話最終取得引用的比例」，需要**多段**樣本；
#    建議 10 段，且內容要落在知識庫涵蓋得到的主題上，否則全數 0 命中、比例無從計算。
# ⚠️ 那支腳本是唯讀的：只 GET 對話與訊息，不 JOIN、不送訊息、不切換 mode。
#    留空時退回上面的 SPIKE_CONVERSATION_ID（單段，只夠看時序、不夠算比例）。
SPIKE_CONVERSATION_IDS=

# 建議卡杜撰引用率的量測（`npm run spike:citation-quality`，specs/005 FR-017）——逗號分隔。
# ⚠️ 口徑是**固定 15 段** × 3 輪 ＝ 45 次帶命中的生成；對話要落在知識庫涵蓋得到的主題上
#    （0 命中的樣本不進分母）。留空時退回上面的 SPIKE_CONVERSATION_IDS。
# ⚠️ 改 prompt 前後各跑一次（--label baseline／after），同一組對話才可比較。
SPIKE_CITATION_CONVERSATION_IDS=

# 知識庫探測用的 board id —— **只讀**：spike:knowledge／spike:format 只對它做 boards.search／boards.get，
# 沒有任何寫入。未設定時前者把 C-2a 記為 unknown 並跳過，後者取 boards.list() 的第一個 board 來查詢。
# ⚠️ 這個鍵**從不**決定寫入目標。會寫 Board 的只有兩處，各自有嚴格來源：
#    · 執行期結案寫入與 spike:closure-latency → IMBRACE_CLOSURE_BOARD_ID，缺值直接 500／中止，不 fallback
#    · spike:board-write → 自建 _spike_closure_ 前綴的拋棄式 board，跑完自行刪除
#    若日後有新 spike 要寫 Board，MUST NOT 讀這個鍵，也 MUST NOT 對寫入目標做「取第一個」的 fallback。
SPIKE_BOARD_ID=

# spike:knowledge／spike:ai 要測的模型名稱（留空則用腳本預設或自動取第一個可用的）
SPIKE_AI_MODEL=

# ══════════════════════════════════════════════════════════════════════
# ③ M4 尚未接線
#    程式目前沒有任何讀取處；nuxt.config.ts 的橋接表與 runtimeConfig 已預留位子。
#    接線時再把 # 拿掉，現在填了也不會有任何效果。
# ══════════════════════════════════════════════════════════════════════

# 多副本時必需（M4 換 RedisStateStore／RedisEventBus，ARCHITECTURE §8.3）。單副本留空即用記憶體實作。
#REDIS_URL=

# webhook HMAC 驗簽用（M4，規格待 iMBrace 提供，ARCHITECTURE §16.3）
#WEBHOOK_SECRET=

# 自建 AI 層的金鑰（備援 VikiAIProvider 用，尚未實作，ARCHITECTURE §8.2b）
#AI_API_KEY=
