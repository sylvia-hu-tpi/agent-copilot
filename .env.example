# 複製為 .env.local 後填入。.env.local 已在 .gitignore 中。

# 環境：develop | sandbox | stable | prodv2
IMBRACE_ENV=sandbox

# ── 認證方式擇一 ──────────────────────────────────
# (A) 已有 access token（最快，跳過 OTP）
IMBRACE_ACCESS_TOKEN=
IMBRACE_ORGANIZATION_ID=

# (B) 走 OTP 流程取得 token（00-auth.ts 會引導）
IMBRACE_EMAIL=

# (C) API Key（server-to-server，非個別客服身分）
IMBRACE_API_KEY=

# ── 探測目標 ──────────────────────────────────────
# 一個「內容夠豐富」的對話 id：最好同時包含
# 客戶訊息、AI 自動回覆、真人客服回覆、圖片、語音
SPIKE_CONVERSATION_ID=

# 知識庫探測用的 board id（若已有 SOP board）
SPIKE_BOARD_ID=

# 05-ai-structured.ts 要測的模型名稱（留空則自動取第一個可用的）
SPIKE_AI_MODEL=
