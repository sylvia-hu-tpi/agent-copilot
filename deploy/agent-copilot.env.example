# AgentCopilot 執行期設定 —— 複製為 agent-copilot.env 後填值（該檔在 .gitignore 裡，只存在部署現場）。
# compose 以 env_file 注入容器；同一份 image 跨環境只換這個檔案，不重建（docs/ARCHITECTURE.md §16.1）。
#
# ⚠️ 這裡的鍵是 Nuxt 的 NUXT_* 慣例，**不是** .env.local 用的 IMBRACE_* ——
#    .env.local 那套是靠 nuxt.config.ts 在 dev／build 時橋接的，執行期的容器沒有那層。
#    對照表就在 nuxt.config.ts 的 ENV_BRIDGE。
# ⚠️ 值不要加引號、不要有尾端空白：env_file 是逐字讀的，引號會變成值的一部分。

# ── 環境 ──────────────────────────────────────────────────────────
# ⚠️ stable 是正式環境，操作的是真實客戶資料（§16.5）。iMBrace 尚未提供 sandbox。
NUXT_PUBLIC_IMBRACE_ENV=stable
# 若 iMBrace 直接給 URL 而非環境名稱才填，否則留空
NUXT_IMBRACE_BASE_URL=

# ── iMBrace 憑證（server-to-server；憲法 1.1：只存在於 server） ──────
# ⚠️ API Key 必須同時填 ORGANIZATION_ID，gateway 不會從 key 推導組織
NUXT_IMBRACE_API_KEY=
NUXT_IMBRACE_ORGANIZATION_ID=

# ── session ───────────────────────────────────────────────────────
# ⚠️ 必填，缺少時所有登入請求回 500。產生一把：
#    node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 換了這把所有人都會被登出（單副本下換版本來就會，見 §18 M3.5 的警語）。
NUXT_SESSION_SECRET=

# ── 五個 iMBrace agent 的 assistant_id（在 iMBrace 後台建立，因環境而異） ──
# ⚠️ 前四個缺任一項會靜默退回 Mock provider（只印警告）—— 面板會有內容，但全是假的。
#    demo 前 MUST 跑 npm run spike:verify-provider／spike:agent-prompts 確認（§8.2b）。
NUXT_IMBRACE_SUMMARY_AGENT_ID=
NUXT_IMBRACE_SENTIMENT_AGENT_ID=
NUXT_IMBRACE_KNOWLEDGE_AGENT_ID=
NUXT_IMBRACE_SUGGESTION_AGENT_ID=
# 第五個缺少時不退回 Mock，按下結案會在產生草稿那一步 502（刻意，見 .env.example 的說明）
NUXT_IMBRACE_CLOSURE_AGENT_ID=

# ── 結案紀錄的 Data Board ─────────────────────────────────────────
# ⚠️ SIT demo MUST 用 demo 專用 Board（§16.5、§18 M3.5）：在有 IMBRACE_* 憑證的機器上
#    以空的 IMBRACE_CLOSURE_BOARD_ID 跑一次 `npm run board:setup`，把印出的 id 填到這裡。
#    MUST NOT 填客戶正式 Board 的 id —— 結案是真寫入，Board 是正式 CRM。
NUXT_IMBRACE_CLOSURE_BOARD_ID=

# ── M4 尚未接線：程式目前沒有任何讀取處，接線時再把 # 拿掉 ─────────────
# 多副本時必需（M4 換 Redis）；單副本用記憶體實作
#NUXT_REDIS_URL=
# webhook HMAC 驗簽（M4，規格待 iMBrace 提供）
#NUXT_WEBHOOK_SECRET=
# 自建 AI 層（尚未實作）
#NUXT_AI_API_KEY=

# ── 可選的執行期調校（沒有 NUXT_ 前綴，程式直接讀 process.env） ──────
# 情緒批次的並行上限（server/services/blocks/sentiment.ts）；留空用程式預設
#SENTIMENT_CONCURRENCY=
# 建議卡引用稽核的額外落點（絕對路徑；預設只寫 stdout ＝ docker logs）。
# 容器以 node 使用者執行，路徑要指到可寫的 volume 才會生效，否則只降級不報錯。
#CITATION_AUDIT_FILE=
