{
  // spike 腳本（tsx）與 test（vitest）都不經 Nuxt/Nitro，共用這份設定。
  // ⚠️ 因此 scripts/ 只能 import「不使用 Nitro auto-import」的 server 檔案
  //    （目前為 server/services/imbrace.ts、server/utils/redact.ts）。
  //    一旦某個 server 檔案開始用 defineEventHandler / useRuntimeConfig，
  //    它就不再能被 spike 直接 import —— 請改抽出純函式共用。
  //
  // ⚠️ paths 必須與 Nuxt 的別名一致：test/ 會 import app/utils/ 底下的純函式
  //    （例如 composer-block.ts），而那些檔案用 `#shared/*` 匯入共用型別。
  //    少了這個對應，vitest 會過（型別匯入在執行期被抹除）但 tsc 會紅 ——
  //    是「測試綠、typecheck 紅」這種難看的不一致。
  "compilerOptions": {
    // ⚠️ 刻意不設 `baseUrl` —— 它在 TS 7.0 會停止運作（編輯器已經在報 deprecated）。
    //    `paths` 自 TS 4.4 起在沒有 baseUrl 時以**本檔所在目錄**為基準，
    //    語意與原本的 `baseUrl: "."` 完全相同，不需要別的補償。
    "paths": {
      "#shared/*": ["./shared/*"]
    },
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["scripts/**/*", "test/**/*", "app/utils/**/*", "vitest.config.ts"],

  // ⚠️ `test/nuxt/**` 不歸本檔管 —— 那是 **Nuxt 自己預留**的測試目錄，
  //    已列在 `.nuxt/tsconfig.app.json` 的 include 裡，由 `nuxt typecheck` 以
  //    真正的 auto-import 與 DOM 型別檢查。那些測試直接載入 `app/` 的前端模組，
  //    在本檔（Node 環境、沒有 DOM 也沒有 auto-import 宣告）下必紅。
  //    ⚠️ 不要為了收編它們而在這裡加 DOM 或自寫全域宣告 ——
  //    同一個模組被兩份設定各檢查一次，其中一次用的是手寫的假型別。
  "exclude": ["node_modules", ".output", ".nuxt", "test/nuxt"]
}
